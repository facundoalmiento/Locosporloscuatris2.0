# Cadena de conexión a Postgres (Neon)
DATABASE_URL="postgresql://usuario:password@host/nombre_db?sslmode=require&channel_binding=require"

# Secreto para firmar los JWT de autenticación (usá una cadena larga y aleatoria)
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Client ID de Google (Google Cloud Console > APIs y servicios > Credenciales).
# Tiene que ser EL MISMO valor que VITE_GOOGLE_CLIENT_ID de abajo.
GOOGLE_CLIENT_ID="xxxxxxxxxx.apps.googleusercontent.com"

# Mismo Client ID de arriba, pero expuesto al frontend (Vite solo expone variables
# que empiezan con VITE_). No es un secreto: este valor es público por diseño.
VITE_GOOGLE_CLIENT_ID="xxxxxxxxxx.apps.googleusercontent.com"

# API key de Resend (resend.com) para mandar el recordatorio de mantenimiento
# por email. Sin esto configurado, el cron simplemente no manda nada (no rompe).
RESEND_API_KEY="re_xxxxxxxxxx"

# Remitente de esos emails. Mientras no verifiques tu propio dominio en Resend,
# dejá el de prueba tal cual está (funciona sin configuración extra).
EMAIL_FROM="Locos por los Cuatris <onboarding@resend.dev>"

# Secreto que Vercel manda automáticamente al disparar el cron job (así nadie
# más puede llamar a /api/cron/recordatorios). Generá cualquier cadena larga
# y aleatoria — Vercel la toma sola del entorno, no hay que configurarla en
# ningún otro lado más que acá.
CRON_SECRET="cambiar-por-otro-secreto-largo-y-aleatorio"

# Puerto del servidor local (server/local.ts) — no aplica en Vercel
PORT=3001

NODE_ENV=development
